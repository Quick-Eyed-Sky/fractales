typedef unsigned int uint;

namespace metal {
struct float2 {
    float x, y;
    float2() : x(0), y(0) {}
    explicit float2(float v) : x(v), y(v) {}
    float2(float a, float b) : x(a), y(b) {}
};
inline float2 operator+(float2 a, float2 b) { return {a.x + b.x, a.y + b.y}; }
inline float2 operator-(float2 a, float2 b) { return {a.x - b.x, a.y - b.y}; }
inline float2 operator*(float s, float2 a) { return {s * a.x, s * a.y}; }
inline float2 operator*(float2 a, float s) { return {s * a.x, s * a.y}; }
struct float3 { float x, y, z; };
struct float4 {
    union {
        struct { float x, y, z, w; };
        struct { float r, g, b, a; };
        float3 rgb;
    };
    float4() : x(0), y(0), z(0), w(0) {}
    float4(float a_, float b_, float c_, float d_) : x(a_), y(b_), z(c_), w(d_) {}
    float4(float2 v, float c_, float d_) : x(v.x), y(v.y), z(c_), w(d_) {}
    float4(float3 v, float d_) : x(v.x), y(v.y), z(v.z), w(d_) {}
};
struct uint2 { uint x, y; };
inline float dot(float2 a, float2 b) { return a.x * b.x + a.y * b.y; }
inline float fract(float v) { return v - std::floor(v); }
using std::log; using std::fmin; using std::fmax; using std::sqrt; using std::max; using std::fabs;

enum class access { read, write, sample };
namespace coord { enum c { normalized, pixel }; }
namespace address { enum a { clamp_to_edge, repeat }; }
namespace filter { enum f { nearest, linear }; }
struct sampler { template <class... T> constexpr sampler(T...) {} };

// Texture: a handle to row-major float RGBA. Sampling here is nearest only (enough for the tests).
template <class T, access A = access::sample> struct texture2d {
    uint w = 0, h = 0;
    float *data = nullptr; // 4 per texel; a handle, as in Metal (copies share the pixels)
    float4 sample(sampler, float2 uv) const {
        uint x = uint(fmin(fmax(fract(uv.x) * w, 0.0f), w - 1.0f)), y = uint(fmin(fmax(uv.y * h, 0.0f), h - 1.0f));
        const float *p = &data[4 * (y * w + x)]; return float4(p[0], p[1], p[2], p[3]);
    }
    void write(float4 v, uint2 g) { float *p = &data[4 * (g.y * w + g.x)]; p[0] = v.x; p[1] = v.y; p[2] = v.z; p[3] = v.w; }
};
}
